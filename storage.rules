rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /files/{fileName} {

      // Student: upload + download
      allow read, write: if request.auth != null
        && request.auth.token.email.matches(".*@student[.]tdtu[.]edu[.]vn$");

      // Teacher: download
      allow read: if request.auth != null
        && request.auth.token.email.matches(".*@tdtu[.]edu[.]vn$")
        && !request.auth.token.email.matches(".*@student[.]tdtu[.]edu[.]vn$");
    }
  }
}
